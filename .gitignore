# ── Local environment / secrets ──────────────────────────────
# Each teammate's WAMP setup may have different DB credentials.
.env
.env.local

# ── User-uploaded content ────────────────────────────────────
# Bank slips, profile photos, PDF header/footer templates — this
# is runtime data, not source code. Grows unbounded, shouldn't be
# in version control, and may contain real student data.
assets/uploads/*
!assets/uploads/.gitkeep

# ── Dependencies ─────────────────────────────────────────────
node_modules/
vendor/

# ── OS / editor junk ─────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
*.swp
.vscode/
.idea/

# ── Logs (if any get generated) ──────────────────────────────
*.log
error_log

# ── Composer binary (local install) ──────────────────────────
composer.phar

# ── Sensitive / secrets ──────────────────────────────────────
note.txt

# ── Dev / debug scripts ──────────────────────────────────────
_gen_bug_report.php

# ── Generated / planning documents ──────────────────────────
document_request_processing_guide.md
CLOUDINARY_PLAN.md
FEATURE_OVERHAUL_PLAN.md
# ── Database backups ─────────────────────────────────────────
database/edocuserve_backup.sql

# ── Binary / media files (not part of system assets) ─────────
*.pdf
*.xlsx
*.xls
image.png

# ── IDE / tool directories ────────────────────────────────────
.claude/
.kiro/

# ── Generated output directories ─────────────────────────────
graphify-out/
"generated contents/"
"Edocuserve files/"
